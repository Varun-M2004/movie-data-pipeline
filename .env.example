MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=movie_analytics

# Free key from http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# Optional: cap OMDb lookups per run (free tier is 1,000 requests/day).
# Leave empty to process every movie, using the local cache to skip repeats.
OMDB_MAX_MOVIES=
